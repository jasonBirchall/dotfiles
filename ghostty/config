# Theme — classic gruvbox (medium dark, #282828 bg).
# Matches gruvbox.nvim and the tmux status bar.
# Alternatives: "Gruvbox Dark Hard" (darker #1d2021 bg),
#               "Gruvbox Material" (softer, lower-contrast palette).
theme = Gruvbox Dark

# Auto-detect the login shell: bash on the Linux hosts, zsh on the Mac.
shell-integration = detect
copy-on-select = clipboard
font-size = 18
