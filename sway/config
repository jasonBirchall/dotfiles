### --- Variables ---
set $mod Mod4
set $term ghostty
set $menu wofi

font pango:monospace 14

### --- Startup ---
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
# Activate the systemd session target so xdg-desktop-portal (and Flatpak apps) work.
exec_always systemctl --user start sway-session.target
exec_always ~/.config/waybar/launch.sh
exec_always sh -lc 'pkill mako; mako'
exec_always sh -lc 'pkill nm-applet; nm-applet --indicator'

# UK keyboard layout
input * {
    xkb_layout gb
}

# Dismiss current notification
bindsym $mod+n exec makoctl dismiss

# Dismiss all notifications
bindsym $mod+Shift+n exec makoctl dismiss -a
bindsym $mod+Shift+m exec makoctl restore

### --- Auto lock ---
exec_always pkill swayidle
exec_always swayidle -w \
    timeout 600 'swaylock -f -C ~/.config/swaylock/config' \
    timeout 900 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    timeout 3800 'systemctl poweroff' \
    before-sleep 'swaylock -f -C ~/.config/swaylock/config'

### --- Lid switch ---
# Lock the screen the moment the laptop lid is closed. Harmless on the
# desktop (no lid switch ever fires). --locked lets it run over the lock
# screen; --reload re-applies the current lid state on config reload.
bindswitch --reload --locked lid:on exec swaylock -f -C ~/.config/swaylock/config

bindsym $mod+Shift+q exec swaylock -f -C ~/.config/swaylock/config

# Lock, then suspend
bindsym $mod+Shift+s exec sh -c 'swaylock -f -C ~/.config/swaylock/config & sleep 0.3; systemctl suspend'

### --- Audio Controls ---
# Volume / mute via Mod + Page Up / Page Down / End
bindsym $mod+Prior exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0
bindsym $mod+Next  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym $mod+End   exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle

# Dedicated keyboard keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute     exec wpctl set-mute   @DEFAULT_SOURCE@     toggle

### --- Media Controls ---
# Talks to any MPRIS-compatible player (Spotify, Firefox, mpv, ...)
bindsym XF86AudioPlay  exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioNext  exec playerctl next
bindsym XF86AudioPrev  exec playerctl previous
bindsym XF86AudioStop  exec playerctl stop

### --- Brightness Controls ---
# brightnessctl sets the panel backlight via systemd-logind (no root / video
# group needed). --locked lets it work while the screen is locked.
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

# wl-kbptr — keyboard-driven pointer
bindsym $mod+g exec ~/.nix-profile/bin/wl-kbptr

### --- NVIDIA stability ---
output * adaptive_sync off
output * scale 1.25
output DP-1 scale_filter linear

### --- Terminal ---
bindsym $mod+Return exec $term

### --- Launcher ---
bindsym $mod+d exec $menu

### --- Help ---
# Searchable list of every keybinding in this config
bindsym $mod+slash exec ~/.config/sway/cheatsheet.sh

### --- Power menu ---
# Lock / Suspend / Hibernate / Logout / Reboot / Shutdown via wofi
bindsym $mod+Shift+End exec ~/.config/sway/powermenu.sh

### --- Exit ---
bindsym $mod+Shift+e exec "swaymsg exit"
bindsym $mod+Shift+r reload
bindsym $mod+q kill

### --- Focus (vim style) ---
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

### --- Move ---
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

### --- Split ---
bindsym $mod+v split v
bindsym $mod+b split h

### --- Layout ---
# splith/splitv: side-by-side or stacked tiles (the default tiling layouts)
# tabbed: only the focused window visible, others as tabs along the top
# stacking: only the focused window visible, others as a vertical title list
bindsym $mod+e layout toggle split
bindsym $mod+w layout tabbed
bindsym $mod+s layout stacking

### --- Fullscreen ---
bindsym $mod+f fullscreen

### --- Floating toggle ---
# Hold $mod and drag a floating window with left-click to move,
# or right-click to resize.
floating_modifier $mod normal
bindsym $mod+Shift+space floating toggle

### --- Resize ---
mode "resize" {
    bindsym h resize shrink width 30px
    bindsym j resize grow height 30px
    bindsym k resize shrink height 30px
    bindsym l resize grow width 30px

    bindsym Left  resize shrink width 30px
    bindsym Down  resize grow height 30px
    bindsym Up    resize shrink height 30px
    bindsym Right resize grow width 30px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### --- Screenshot ---
# Print            area  -> clipboard
# Shift+Print      full  -> clipboard
# $mod+Print       area  -> ~/Pictures/screenshots/<timestamp>.png
bindsym Print       exec grim -g "$(slurp)" - | wl-copy && notify-send 'Screenshot' 'Area copied to clipboard'
bindsym Shift+Print exec grim - | wl-copy && notify-send 'Screenshot' 'Full screen copied to clipboard'
bindsym $mod+Print  exec sh -c 'd="$HOME/Pictures/screenshots"; mkdir -p "$d"; f="$d/$(date +%Y-%m-%d_%H%M%S).png"; grim -g "$(slurp)" "$f" && notify-send "Screenshot" "Saved to $f"'

gaps inner 14
gaps outer 6
default_border pixel 4

# class                 border   bg       text     indicator child_border
client.focused          #ff5f00  #ff5f00  #ffffff  #ff5f00   #ff5f00
client.focused_inactive #2e3440  #2e3440  #888888  #2e3440   #2e3440
client.unfocused        #1e1e1e  #1e1e1e  #666666  #1e1e1e   #1e1e1e

### --- Workspaces ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
