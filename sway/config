### --- Variables ---
set $mod Mod4
set $term ghostty
set $menu wofi

font pango:monospace 14

### --- Startup ---
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec_always sh -lc 'pkill waybar; waybar'
exec_always sh -lc 'pkill mako; mako'
exec_always sh -lc 'pkill nm-applet; nm-applet --indicator'

# UK keyboard layout
input * {
    xkb_layout gb
}

# Dismiss current notification
bindsym $mod+n exec makoctl dismiss

# Dismiss all notifications
bindsym $mod+Shift+n exec makoctl dismiss -a
bindsym $mod+Shift+m exec makoctl restore

### --- Auto lock ---
exec_always pkill swayidle
exec_always swayidle -w \
    timeout 600 'swaylock -f -C ~/.config/swaylock/config' \
    timeout 900 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    timeout 3800 'systemctl poweroff' \
    before-sleep 'swaylock -f -C ~/.config/swaylock/config'

bindsym $mod+Shift+q exec swaylock -f -C ~/.config/swaylock/config

# Lock then suspend
bindsym $mod+Shift+s exec sh -c 'systemctl poweroff'

### --- Audio Controls ---
# Increase volume by 5% (Mod + Page Up)
bindsym $mod+Prior exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0

# Decrease volume by 5% (Mod + Page Down)
bindsym $mod+Next exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

# Toggle mute (Mod + End)
bindsym $mod+End exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# wl-kbptr — keyboard-driven pointer
bindsym $mod+g exec ~/.nix-profile/bin/wl-kbptr

### --- NVIDIA stability ---
output * adaptive_sync off
output * scale 1.25
output DP-1 scale_filter linear

### --- Terminal ---
bindsym $mod+Return exec $term

### --- Launcher ---
bindsym $mod+d exec $menu

### --- Exit ---
bindsym $mod+Shift+e exec "swaymsg exit"
bindsym $mod+Shift+r reload
bindsym $mod+q kill

### --- Focus (vim style) ---
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

### --- Move ---
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

### --- Split ---
bindsym $mod+v split v
bindsym $mod+b split h

### --- Fullscreen ---
bindsym $mod+f fullscreen

### --- Floating toggle ---
bindsym $mod+Shift+space floating toggle

### --- Screenshot ---
bindsym $mod+Print exec grim -g "$(slurp)" - | wl-copy

gaps inner 14
gaps outer 6
default_border pixel 4

# class                 border   bg       text     indicator child_border
client.focused          #ff5f00  #ff5f00  #ffffff  #ff5f00   #ff5f00
client.focused_inactive #2e3440  #2e3440  #888888  #2e3440   #2e3440
client.unfocused        #1e1e1e  #1e1e1e  #666666  #1e1e1e   #1e1e1e

### --- Workspaces ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
