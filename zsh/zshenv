# Environment variables (loaded for all shells)
export EDITOR=/opt/homebrew/bin/nvim
export GIT_EDITOR=${EDITOR}
export KUBE_EDITOR=${EDITOR}
export GOPATH=$HOME/go
export GPG_TTY=$(tty)
export KUBECONFIG=$HOME/.kube/config
export RANGER_LOAD_DEFAULT_RC='TRUE'
export ZDOTDIR=$HOME/.config/zsh
export ZK_NOTEBOOK_DIR="$HOME/Documents/zettlekasten"

# Ensure unique PATH entries
typeset -U PATH path

# Additional tools
eval "$(rbenv init - zsh)"
. "$HOME/.cargo/env"

# File descriptor limit for neovim
ulimit -S -n 200048
