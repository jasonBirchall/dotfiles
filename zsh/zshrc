# Path to oh-my-zsh installation
export ZSH="$ZDOTDIR/ohmyzsh"

# Autosuggestions config
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=244"
source $HOME/Documents/workarea/dotfiles.nosync/zsh/packages/zsh-autosuggestions/zsh-autosuggestions.zsh

# Emacs keybindings
bindkey -e

# oh-my-zsh settings
ENABLE_CORRECTION="true"

# Plugins (removed duplicate tmux)
plugins=(git python tmux pip virtualenv autopep8 command-not-found macos)

source $ZSH/oh-my-zsh.sh

# PATH (consolidated)
path=("/opt/homebrew/bin" "$HOME/bin" "$HOME/.local/bin" "/usr/bin" "/usr/local/bin" "/bin" "$HOME/.gem/bin" "/usr/local/go/bin" "$HOME/go/bin" $path)
export PATH

# Aliases
alias cdw='cd ~/Documents/workarea'
alias cdd='cd ~/Documents/workarea/dotfiles.nosync'
alias cdp='cd $GOPATH'
alias cdu='cd ~/Documents/workarea/university-work'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias v="nvim"
alias vf="vifm"
alias vim="nvim"
alias vi="nvim"
alias :q="exit"
alias gcz="cz commit"
alias tf='terraform'
alias g='git'
alias gs='git status; git diff'
alias gd='git diff'
alias ga='git add'
alias gc='git commit'
alias lg='lazygit'
alias k='kubectl'
alias yq="yq e '.' -"
alias tmux="TERM=screen-256color-bce tmux"
alias r='ranger'
alias watch='watch --color'
alias py="/opt/homebrew/bin/python3"

# Completions
autoload -Uz compinit
zstyle ':completion:*' menu select
fpath+=~/.zfunc

# Starship prompt
eval "$(starship init zsh)"

# Syntax highlighting (MUST be last)
source $HOME/Documents/workarea/dotfiles.nosync/zsh/packages/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
