font=JetBrains Mono 14
background-color=#1d2021
text-color=#ebdbb2
border-color=#458588
progress-color=#458588

border-size=2
border-radius=8
padding=12
margin=10
width=400
max-visible=5

default-timeout=5000
max-history=50

# Urgent notifications
[urgency=critical]
background-color=#cc241d
text-color=#fbf1c7
border-color=#fbf1c7
default-timeout=0

# Recon drift — wider, taller, sticky until dismissed.
# Triggered by bin/recon/recon-notify@.service, which passes --app-name=recon.
# (mako has no max-lines option; height is a max that shrinks to fit content.)
[app-name=recon]
width=700
height=300
default-timeout=0
