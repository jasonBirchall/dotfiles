{
  "layer": "top",
  "position": "top",
  "height": 40,

  "modules-left": ["sway/workspaces"],
  "modules-center": [],
  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "battery",
    "tray",
    "clock"
  ],

  "clock": {
    "format": "  {:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}"
  },

  "cpu": {
    "format": "  {usage}%",
    "interval": 5
  },

  "memory": {
    "format": "  {used:0.1f}G",
    "interval": 5
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  Wired",
    "format-disconnected": "  Offline"
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "states": { "warning": 30, "critical": 15 },
    "interval": 30
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  Muted"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10
  }
}
